        <mxCell id="ref-titulo" value="Referencias" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="122" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="ref-comp-txt" value="&lt;b&gt;Composición&lt;/b&gt;: la parte pertenece al dueño y se destruye con él (el dueño hace &lt;i&gt;delete&lt;/i&gt;, o la parte es un atributo por valor). Del lado del rombo la multiplicidad es 1." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="154" width="440" height="52" as="geometry" /></mxCell>
        <mxCell id="ref-asoc-txt" value="&lt;b&gt;Asociación&lt;/b&gt;: guarda un puntero, pero no destruye el objeto." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="216" width="440" height="20" as="geometry" /></mxCell>
        <mxCell id="ref-dep-txt" value="&lt;b&gt;Dependencia&lt;/b&gt;: la usa solo dentro de un método (variable local)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="246" width="440" height="20" as="geometry" /></mxCell>
        <mxCell id="ref-vis" value="Visibilidad: + público, - privado. Solo se muestran los getters que usan otras clases." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="332" width="520" height="20" as="geometry" /></mxCell>
